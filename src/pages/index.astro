---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ship from '../components/Ship.astro';
import DaySync from '../components/DaySync.astro';
import Kachkachi from '../components/Kachkachi.astro';
import AIWhisper from '../components/AIWhisper.astro';
import Experience from '../components/Experience.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Dock from '../components/Dock.astro';
---

<Base>
  <Header />
  <main id="main">
    <Hero />
    <Ship />
    <div class="rooms" id="projects">
      <DaySync />
      <Kachkachi />
      <AIWhisper />
    </div>
    <Experience />
    <Contact />
  </main>
  <Footer />
  <Dock />
  <script>
    import '../scripts/clock';
    import '../scripts/copy-email';
    import '../scripts/dock';
    import '../scripts/experience';
  </script>
</Base>
