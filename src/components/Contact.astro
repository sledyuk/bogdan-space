---
import { site, contact } from '../data/site';
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="contact-sheet">
    <div class="wrap">
      <h2 class="sec-title" id="contact-title">{contact.title}</h2>
      <p>{contact.text}</p>
      <div class="mail">
        <a class="mail-addr" href={`mailto:${site.email}`}>{site.email}</a>
        <button class="btn btn-primary" type="button" data-copy={site.email} data-done="Copied">Copy email</button>
        <a class="btn" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn" href={site.github} target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>
  </div>
</section>
