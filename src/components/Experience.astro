---
import { experience, kindLabel, about, type Kind } from '../data/site';

const count = (k: Kind) => experience.filter((j) => j.kind === k).length;
const filters: { key: 'all' | Kind; label: string; n?: number }[] = [
  { key: 'all', label: 'All' },
  { key: 'own', label: 'Own products', n: count('own') },
  { key: 'freelance', label: 'Freelance', n: count('freelance') },
  { key: 'company', label: 'Companies', n: count('company') },
];
---

<section class="sec wrap" id="experience" aria-labelledby="xp-title">
  <div class="xp-head">
    <h2 class="sec-title" id="xp-title">Experience</h2>
    <div class="filter" role="group" aria-label="Show by kind of work">
      {filters.map((f, i) => (
        <button type="button" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
          {f.label}{f.n !== undefined && <span class="num">{f.n}</span>}
        </button>
      ))}
    </div>
  </div>

  <ol class="sheet xp" id="xp">
    {experience.map((job, i) => (
      <li data-kind={job.kind} class:list={{ first: i === 0 }}>
        <span class="yr">{job.years}</span>
        <div class="org">
          <h3>{job.org}</h3>
          <p class="role">{job.role}</p>
          <span class="chip kind"><span class:list={['dot', job.kind]}></span>{kindLabel[job.kind]}</span>
        </div>
        <ul class="projs">
          {job.projects.map((pr) => (
            <li>
              <div class="proj-top">
                {pr.name && <b>{pr.name}</b>}
                {pr.domains.map((d) => <span class="chip dom">{d}</span>)}
                {pr.platforms.map((pl) => <span class="chip">{pl}</span>)}
              </div>
              <p>{pr.text}</p>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>

  <div class="about">
    <div class="about-photo">
      <img src="/assets/portrait.webp" alt="Bogdan Egikov" width="760" height="760" loading="lazy" decoding="async" />
    </div>
    <div class="sheet about-card">
      <p>{about.text}</p>
      <div>
        <h3>Day to day</h3>
        <ul class="chips">{about.dayToDay.map((s) => <li class="chip">{s}</li>)}</ul>
      </div>
      <div>
        <h3>Also</h3>
        <ul class="chips">{about.also.map((s) => <li class="chip">{s}</li>)}</ul>
      </div>
    </div>
  </div>
</section>
