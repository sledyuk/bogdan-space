---
import { featuredProjects, allProjects } from '../data/site';
const allCount = allProjects.items.length;
---

<nav class="dock" aria-label="Site">
  <a class="dock-island" href="#contact" aria-label="Contact" title="Contact">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"></rect><path d="M4 8l8 6 8-6"></path></svg>
  </a>
  <div class="dock-panel">
    <a class="dock-item" href="#process" data-spy="process">How I ship</a>
    <a class="dock-item" href="#experience" data-spy="experience">Experience</a>
    <details class="dock-menu" id="projects-menu">
      <summary class="dock-item" data-spy="projects">Projects</summary>
      <ul>
        {featuredProjects.map((p) => (
          <li>
            <a href={p.href}>
              <img src={p.icon} alt="" width="160" height="160" loading="lazy" decoding="async" />
              <span>{p.name}<small>{p.note}</small></span>
            </a>
          </li>
        ))}
        <li class="dock-all">
          <a href="#all-projects">
            <span class="all-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="6" height="6" rx="1.5"></rect><rect x="14" y="4" width="6" height="6" rx="1.5"></rect><rect x="4" y="14" width="6" height="6" rx="1.5"></rect><rect x="14" y="14" width="6" height="6" rx="1.5"></rect></svg></span>
            <span>All projects<small>{allCount} products, live and closed</small></span>
          </a>
        </li>
      </ul>
    </details>
  </div>
</nav>
