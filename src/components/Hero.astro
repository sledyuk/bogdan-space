---
import { site, hero, specRows, ownProducts } from '../data/site';
---

<section class="hero wrap" aria-label="Introduction">
  <div class="hero-grid">
    <div>
      <h1>{hero.headline}</h1>
      <p class="hero-lead">{hero.lead}</p>
      <div class="actions">
        <button class="btn btn-primary" type="button" data-copy={site.email} data-done="Copied" title={site.email}>Copy email</button>
        <a class="btn" href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn" href={site.resumePath} download>Résumé</a>
      </div>
    </div>

    <div class="spec-card">
      <div class="spec-head">
        <div class="who">
          <img src="/assets/portrait-sm.webp" alt="Portrait of Bogdan Egikov" width="160" height="160" />
          <span>{site.name}</span>
        </div>
        <span class="chip"><span class="dot"></span>Tbilisi <span class="num" data-clock>{site.timezoneLabel}</span></span>
      </div>
      <dl class="spec">
        {specRows.map((r) => (
          <div class="row">
            <dt>{r.k}</dt>
            <dd>
              {r.products
                ? ownProducts.map((p) => (
                    <a class="prod" href={p.href}>
                      <img src={p.icon} alt="" width="160" height="160" />
                      {p.name}
                    </a>
                  ))
                : r.v}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
